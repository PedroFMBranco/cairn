def dep_version(argv, pick):
    try:
        r = run(argv, timeout=5)
    except CairnError:
        return None
    if r.returncode != 0:
        return None
    return pick((r.stdout or r.stderr).strip())


def claude_login(claude):
    """"yes", "no" or "unknown": whether claude has a login of its own here, as `claude auth status` tells a lead,
    whose pane has no token variable. On macOS "no" reads as "unknown": over ssh claude reads its login from the
    Keychain, and a Keychain it cannot read there may still hold one (untested)."""
    if not claude:
        return "unknown"
    try:
        r = run([claude, "auth", "status", "--json"], timeout=10, env=tmux_env())
        logged_in = json.loads(r.stdout).get("loggedIn")
    except (CairnError, ValueError, AttributeError):
        return "unknown"
    if logged_in is True:
        return "yes"
    return "no" if logged_in is False and sys.platform != "darwin" else "unknown"


def first_version(text):
    m = re.search(r"\d+(?:\.\d+)+\w*", text)
    return m.group(0) if m else None


def free_ram_mb():
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) // 1024
    except (OSError, ValueError, IndexError):
        pass
    try:
        out = run(["vm_stat"], timeout=5).stdout
        page = int(re.search(r"page size of (\d+)", out).group(1))
        pages = sum(int(re.search(rf"Pages {k}:\s+(\d+)", out).group(1))
                    for k in ("free", "inactive"))
        return pages * page // (1024 * 1024)
    except Exception:
        return None


def section(text, heading):
    out, on = [], False
    for line in text.replace("\r\n", "\n").split("\n"):
        m = re.match(r"^##\s+(.*?)\s*$", line)
        if m:
            on = m.group(1).lower() == heading.lower()
            continue
        if on:
            out.append(line)
    return out


def read_map(repo, warnings, name):
    path = repo / "work" / "map.md"
    if not path.exists():
        return {"destination": "", "decisions": []}
    try:
        text = read_file(path)
    except OSError as e:
        warnings.append({"warning": f"{name}: cannot read work/map.md: {e}"})
        return {"destination": "", "decisions": []}
    dest = " ".join(l.strip() for l in section(text, "Destination") if l.strip())
    decisions = [l.strip() for l in section(text, "Decisions so far")
                 if l.strip().startswith(("-", "*"))]
    return {"destination": dest, "decisions": decisions}


def read_tickets(repo, warnings, name):
    tickets = []
    tdir = repo / "work" / "tickets"
    for f in sorted(tdir.glob("*.md")) if tdir.is_dir() else []:
        rel = f"work/tickets/{f.name}"
        try:
            meta, _ = parse_frontmatter(read_file(f))
            if not meta:
                raise ValueError("no frontmatter")
        except (OSError, ValueError) as e:
            warnings.append({"warning": f"{name}: skipped {rel}: {e}"})
            continue
        m = re.match(r"^(\d+)", f.name)
        tid = str(meta.get("id") or (m.group(1) if m else f.stem))
        tickets.append({
            "id": tid, "title": str(meta.get("title") or f.stem),
            "type": str(meta.get("type") or ""),
            "status": "closed" if str(meta.get("status", "")).lower() == "closed" else "open",
            "assignee": str(meta.get("assignee") or ""),
            "blocked_by": as_list(meta.get("blocked_by", [])),
            "path": rel,
        })
    return tickets


def read_questions(repo, warnings, name):
    questions = []
    idir = repo / "work" / "inbox"
    files = sorted(idir.glob("q*.md")) if idir.is_dir() else []
    for f in files:
        if f.name.endswith(".answer.md"):
            continue
        rel = f"work/inbox/{f.name}"
        try:
            meta, body = parse_frontmatter(read_file(f))
            if not meta:
                raise ValueError("no frontmatter")
        except (OSError, ValueError) as e:
            warnings.append({"warning": f"{name}: skipped {rel}: {e}"})
            continue
        qid = str(meta.get("id") or f.stem)
        lines = [l.rstrip() for l in body.split("\n")]
        options = [l.strip() for l in lines if OPTION_RE.match(l.strip())]
        context = next((l.strip() for l in lines
                        if l.strip() and not OPTION_RE.match(l.strip())), "")
        q = {"id": qid, "ticket": str(meta.get("ticket") or ""),
             "gate": truthy(meta.get("gate", "no")),
             "default": str(meta.get("default") or ""),
             "asked_at": str(meta.get("asked_at") or ""),
             "context": context, "options": options,
             # what the dashboard shows; answer refuses a fingerprint that no longer matches
             "fingerprint": hashlib.sha256("\n".join([context, *options]).encode()).hexdigest(),
             "answered": False, "choice": None, "answered_at": None,
             "applied": str(meta.get("applied") or "") or None, "path": rel}
        ans = idir / f"{f.stem}.answer.md"
        if ans.exists():
            q["answered"] = True
            try:
                am, _ = parse_frontmatter(read_file(ans))
                q["choice"] = str(am.get("choice") or "") or None
                q["answered_at"] = str(am.get("answered_at") or "") or None
            except (OSError, ValueError) as e:
                warnings.append({"warning": f"{name}: bad answer file for {qid}: {e}"})
        questions.append(q)
    return questions


def read_adrs(repo, warnings, name):
    adrs = []
    adir = repo / "work" / "adr"
    for f in sorted(adir.glob("*.md")) if adir.is_dir() else []:
        rel = f"work/adr/{f.name}"
        try:
            first = read_file(f, 4096).split("\n")[0].strip()
        except OSError as e:
            warnings.append({"warning": f"{name}: skipped {rel}: {e}"})
            continue
        m = re.match(r"^(\d+)", f.name)
        title = re.sub(r"^#+\s*", "", first) or f.stem
        adrs.append({"id": m.group(1) if m else f.stem, "title": title, "path": rel})
    return adrs


def read_commits(repo):
    if not (repo / ".git").exists():
        return []
    try:
        r = run(["git", "log", "-10", "--format=%h%x09%aI%x09%s"], cwd=repo)
    except CairnError:
        return []
    if r.returncode != 0:
        return []
    out = []
    for line in r.stdout.splitlines():
        parts = line.split("\t", 2)
        if len(parts) == 3:
            out.append({"sha": parts[0], "date": parts[1], "subject": parts[2]})
    return out


def ticket_states(tickets, questions):
    status_of = {norm_id(t["id"]): t["status"] for t in tickets}
    waiting_on = {norm_id(q["ticket"]) for q in questions if not q["answered"] and q["ticket"]}
    for t in tickets:
        if t["status"] == "closed":
            t["state"] = "closed"
        elif norm_id(t["id"]) in waiting_on:
            t["state"] = "waiting"
        elif t["assignee"]:
            t["state"] = "claimed"
        elif any(status_of.get(norm_id(b)) == "open" for b in t["blocked_by"]):
            t["state"] = "blocked"
        else:
            t["state"] = "frontier"


LEAD_MARK_RE = re.compile(r"^<!-- cairn LEAD\.md v(\d+) -->\s*$", re.M)


def lead_version(repo):
    """The template version LEAD.md was rendered from; 1 for files from before the marker."""
    try:
        m = LEAD_MARK_RE.search(read_file(repo / "LEAD.md"))
    except OSError:
        return 1
    return int(m.group(1)) if m else 1


def template_version():
    try:
        m = LEAD_MARK_RE.search(find_template().read_text())
    except (OSError, CairnError):
        return None
    return int(m.group(1)) if m else 1


def read_result(repo):
    """work/result.md when it is a regular file, capped."""
    try:
        text = read_file(repo / "work" / "result.md", RESULT_MAX * 4 + 4)
    except OSError:
        return None
    return text[:RESULT_MAX] + "…" if len(text) > RESULT_MAX else text


def project_snapshot(name, entry, warnings):
    repo = Path(entry.get("path", ""))
    if not repo.is_dir():
        warnings.append({"warning": f"{name}: path missing: {repo}"})
        return None
    status = "unknown"
    try:
        first = read_file(repo / "work" / "status", 4096).strip().split("\n")[0].strip()
        if STATUS_RE.match(first):
            status = first
    except OSError:
        pass
    stopped = False
    alive = session_alive(name, timeout=3)
    if alive:
        lead = "alive"
    elif alive is None:
        lead = "unknown"   # tmux did not answer; "dead" would read as a crash on the hub
    else:
        lead = "dead" if marker(name).exists() else "none"
        if lead == "dead":
            try:
                stopped = bool(json.loads(marker(name).read_text()).get("stopped"))
            except (OSError, ValueError, AttributeError):
                pass
    tickets = read_tickets(repo, warnings, name)
    questions = read_questions(repo, warnings, name)
    ticket_states(tickets, questions)
    result = read_result(repo)
    result_sha = None
    if result is not None and (repo / ".git").exists():
        try:
            r = run(["git", "log", "-1", "--format=%h", "--", "work/result.md"], cwd=repo)
            result_sha = r.stdout.strip() or None if r.returncode == 0 else None
        except CairnError:
            pass
    last, state, note = pane_view(name) if lead == "alive" else (None, None, None)
    if state == "prompt" and agents_writing(name, repo):
        state = "working"   # the lead ended its turn to wait for its background agents' completion notices
    return {"name": name, "path": str(repo), "status": status, "lead": lead,
            "lead_stopped": stopped, "pane_last": last, "lead_state": state, "lead_note": note, "lead_version": lead_version(repo),
            "review": "alive" if session_alive(name + REVIEW_SUFFIX, timeout=3) else "none",
            "map": read_map(repo, warnings, name), "tickets": tickets,
            "questions": questions, "result": result, "result_sha": result_sha, "adrs": read_adrs(repo, warnings, name),
            "commits": read_commits(repo)}


def cmd_snapshot(args):
    warnings, projects = [], []
    claude = resolve_claude()
    for name, entry in sorted(load_projects().items()):
        try:
            snap = project_snapshot(name, entry or {}, warnings)
        except Exception as e:
            warnings.append({"warning": f"{name}: {e}"})
            continue
        if snap:
            projects.append(snap)
    return {
        "node_version": VERSION, "lead_template_version": template_version(),
        "host": socket.gethostname(), "time": now_iso(),
        "free_ram_mb": free_ram_mb(),
        "free_disk_mb": shutil.disk_usage(home()).free // (1024 * 1024),
        "deps": {
            "tmux": dep_version(["tmux", "-V"], first_version),
            "git": dep_version(["git", "--version"], first_version),
            "python3": platform.python_version(),
            "claude": dep_version([claude, "--version"], first_version) if claude else None,
        },
        "login": claude_login(claude),
        "projects": projects, "warnings": warnings,
    }


