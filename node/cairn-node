def slugify(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:50] or "ticket"


def find_template():
    here = Path(os.path.realpath(__file__)).parent
    for d in (here, cairn_home()):
        p = d / "LEAD.md.tmpl"
        if p.is_file():
            return p
    raise CairnError("LEAD.md.tmpl not found next to cairn-node or in ~/.cairn")


def render(template, values):
    return re.sub(r"\{\{(\w+)\}\}", lambda m: values.get(m.group(1), m.group(0)), template)


def set_git_identity(path, added):
    """Set the lead identity where none is configured; append each key set to `added`."""
    for key, value in (("user.name", "cairn lead"), ("user.email", "lead@cairn.local")):
        r = run(["git", "config", "--get", key], cwd=path)
        if r.returncode != 0 or not r.stdout.strip():
            r = run(["git", "config", "--local", key, value], cwd=path)
            if r.returncode != 0:
                raise CairnError(f"git config {key} failed: {(r.stderr or r.stdout).strip()}")
            added.append(key)


def undo_init(path, existed, had_git, kind, files, dirs, identity):
    """Remove what a failed init created, so the same init can be retried."""
    if not existed:
        shutil.rmtree(path, ignore_errors=True)
        return
    if kind == "clone":
        for child in path.iterdir():
            if child.is_dir() and not child.is_symlink():
                shutil.rmtree(child, ignore_errors=True)
            else:
                child.unlink(missing_ok=True)
        return
    for f, old in files.items():
        if old is None:
            f.unlink(missing_ok=True)
        else:
            f.write_text(old)
    for d in reversed(dirs):
        try:
            d.rmdir()
        except OSError:
            pass
    if not had_git:
        shutil.rmtree(path / ".git", ignore_errors=True)
        return
    if files:   # with no paths, git reset would unstage the operator's whole index
        run(["git", "reset", "-q", "--", *(str(f.relative_to(path)) for f in files)], cwd=path)
    for key in identity:
        run(["git", "config", "--local", "--unset", key], cwd=path)


def cmd_init(args):
    if len(args) != 1:
        raise CairnError("usage: init <project>")
    project = args[0]
    if not NAME_RE.match(project):
        raise CairnError(f"invalid project name: {project!r}")
    if project.endswith(REVIEW_SUFFIX):   # the tmux session of project x's review is x-review
        raise CairnError(f"a project name must not end in {REVIEW_SUFFIX}: {project!r}")
    try:
        spec = json.loads(sys.stdin.read())
    except ValueError as e:
        raise CairnError(f"init object is not valid JSON: {e}")
    if not isinstance(spec, dict):
        raise CairnError("init object must be a JSON object")
    path = Path(os.path.expanduser(str(spec["path"]))) if spec.get("path") else home() / "work" / project
    if not path.is_absolute():
        raise CairnError("path must be absolute")
    destination = str(spec.get("destination") or "").strip()
    if not destination:
        raise CairnError("init object needs a destination")
    repo = spec.get("repo") or {}
    kind = repo.get("kind", "new")
    tickets = spec.get("tickets") or []
    for t in tickets:
        if not str(t.get("title") or "").strip():
            raise CairnError("every ticket needs a title")
        if t.get("type", "task") not in TICKET_TYPES:
            raise CairnError(f"ticket type must be one of {', '.join(TICKET_TYPES)}")
    template = find_template().read_text()
    projects = load_projects()
    if project in projects and projects[project].get("path") != str(path):
        raise CairnError(f"project {project} already registered at {projects[project].get('path')}")

    if kind == "clone":
        url = repo.get("url")
        if not url:
            raise CairnError("clone needs repo.url")
        if path.exists() and any(path.iterdir()):
            raise CairnError(f"{path} is not empty")
    elif kind == "existing":
        if not (path / ".git").exists():
            raise CairnError(f"{path} is not a git repo")
    elif kind != "new":
        raise CairnError("repo.kind must be new, clone or existing")
    if (path / "work" / "map.md").exists():
        raise CairnError(f"{path} already has work/map.md")

    existed, had_git = path.exists(), (path / ".git").exists()
    files, dirs, identity = {}, [], []  # what this init wrote, for undo_init
    registered = False

    def register(data):
        """Add the project unless another init registered it elsewhere meanwhile; True when this run added it."""
        have = data.get(project)
        if have and have.get("path") != str(path):
            raise CairnError(f"project {project} already registered at {have.get('path')}")
        data[project] = {"path": str(path)}
        return have is None

    def refuse_link(rel):
        # a cloned or existing repo may ship work/status -> ~/.cairn/projects.json
        if (path / rel).is_symlink():
            raise CairnError(f"{rel} is a symlink; init does not write through it")

    def write(rel, text):
        f = path / rel
        refuse_link(rel)
        files.setdefault(f, read_file(f, errors="strict", whole=True) if f.exists() else None)
        fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
        with os.fdopen(fd, "w") as fh:
            fh.write(text)

    try:
        if kind == "clone":
            path.parent.mkdir(parents=True, exist_ok=True)
            r = run(["git", "clone", "--", url, str(path)], timeout=600)
            if r.returncode != 0:
                raise CairnError(f"git clone failed: {(r.stderr or r.stdout).strip()}")
            if (path / "work" / "map.md").exists():
                raise CairnError(f"{path} already has work/map.md")
        elif kind == "new":
            path.mkdir(parents=True, exist_ok=True)
            if not had_git:
                r = run(["git", "init"], cwd=path)
                if r.returncode != 0:
                    raise CairnError(f"git init failed: {(r.stderr or r.stdout).strip()}")

        notes = str(spec.get("notes") or "").strip()
        created = ["LEAD.md", "work/map.md"]
        for d in ("work", "work/tickets", "work/adr", "work/inbox"):
            refuse_link(d)
            if not (path / d).is_dir():
                (path / d).mkdir()
                dirs.append(path / d)
        write("work/map.md",
              f"# {project}\n\n## Destination\n\n{destination}\n\n## Notes\n\n{notes}\n\n"
              "## Decisions so far\n\n## Not yet specified\n\n## Out of scope\n")
        # Empty until the lead writes it, so the snapshot says "unknown".
        write("work/status", "")
        for i, t in enumerate(tickets, 1):
            tid = f"{i:02d}"
            title = str(t["title"]).strip().replace("\n", " ")
            created.append(f"work/tickets/{tid}-{slugify(title)}.md")
            write(created[-1],
                  f"---\nid: {tid}\ntitle: {json.dumps(title, ensure_ascii=False)}\ntype: {t.get('type', 'task')}\n"
                  f"status: open\nassignee:\nblocked_by: []\n---\n## Question\n\n"
                  f"{str(t.get('question') or '').strip()}\n")
        write("LEAD.md", render(template, {
            "project": project, "destination": destination,
            "notes": notes or "None."}))
        for d in ("tickets", "adr", "inbox"):
            if not any((path / "work" / d).iterdir()):
                created.append(f"work/{d}/.gitkeep")
                write(created[-1], "")
        set_git_identity(path, identity)
        registered = update_projects(register)
        git_commit(path, f"cairn: init {project}", created)
    except BaseException:
        undo_init(path, existed, had_git, kind, files, dirs, identity)
        if registered:   # never an older registration of the same project
            update_projects(lambda data: data.pop(project, None))
        raise
    return {"project": project, "path": str(path)}

# ---------- ticket ----------

def one_line(text):
    return " ".join(str(text).split())


def load_ticket_files(repo):
    """[(id, path, meta, text)] for every readable ticket file."""
    found = []
    tdir = repo / "work" / "tickets"
    for f in sorted(tdir.glob("*.md")) if tdir.is_dir() else []:
        try:
            text = read_file(f, errors="strict", whole=True)
            meta, _ = parse_frontmatter(text)
        except (OSError, ValueError):
            continue
        m = re.match(r"^(\d+)", f.name)
        tid = str(meta.get("id") or (m.group(1) if m else f.stem))
        found.append((tid, f, meta, text))
    return found


def next_ticket_id(repo, found):
    """Highest id in use + 1, counting the NN- prefix of every ticket file,
    including files whose frontmatter does not parse."""
    nums = [int(norm_id(tid)) for tid, _, _, _ in found if norm_id(tid).isdigit()]
    tdir = repo / "work" / "tickets"
    for f in tdir.glob("*.md") if tdir.is_dir() else []:
        m = re.match(r"^(\d+)", f.name)
        if m:
            nums.append(int(m.group(1)))
    return f"{(max(nums) if nums else 0) + 1:02d}"


@contextlib.contextmanager
def ticket_lock(repo):
    """Serialize dashboard ticket ops on one repo (id allocation, write, commit)."""
    r = run(["git", "rev-parse", "--absolute-git-dir"], cwd=repo)
    if r.returncode != 0:
        raise CairnError(f"git rev-parse failed: {(r.stderr or r.stdout).strip()}")
    fd = os.open(Path(r.stdout.strip()) / "cairn-ticket.lock", os.O_RDWR | os.O_CREAT, 0o644)
    try:
        deadline = time.monotonic() + TICKET_LOCK_WAIT
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    raise CairnError("another ticket op is still running; retry in a moment")
                time.sleep(0.05)
        yield
    finally:
        os.close(fd)


def check_no_cycle(found, tid, blocked):
    """Refuse blocked_by for `tid` if a chain of blockers leads back to it."""
    edges = {norm_id(t[0]): [norm_id(b) for b in as_list(t[2].get("blocked_by", []))] for t in found}
    start = norm_id(tid)
    edges[start] = [norm_id(b) for b in blocked]
    stack, seen = [[start, b] for b in edges[start]], set()
    while stack:
        chain = stack.pop()
        if chain[-1] == start:
            shown = (c.zfill(2) if c.isdigit() else c for c in chain)
            raise CairnError(f"blocked_by would make a cycle: {' -> '.join(shown)}")
        if chain[-1] in seen:
            continue
        seen.add(chain[-1])
        stack.extend(chain + [b] for b in edges.get(chain[-1], []))


def check_blockers(value, known, self_id=None):
    if value is None:
        return []
    if not isinstance(value, list):
        raise CairnError("blocked_by must be a list of ticket ids")
    ids = [str(v).strip() for v in value]
    for b in ids:
        if norm_id(b) not in known:
            raise CairnError(f"unknown blocker ticket: {b}")
        if self_id is not None and norm_id(b) == norm_id(self_id):
            raise CairnError("a ticket cannot block itself")
    return ids


def need_text(op, key):
    value = op.get(key)
    if not isinstance(value, str) or not one_line(value):
        raise CairnError(f"{key} is required")
    return value.strip()


def open_unclaimed(found, tid):
    want = norm_id(tid)
    for t in found:
        if norm_id(t[0]) == want:
            _, path, meta, text = t
            title = str(meta.get("title") or path.stem)
            if str(meta.get("status", "")).lower() == "closed":
                raise CairnError(f"ticket {t[0]} is closed")
            if str(meta.get("assignee") or "").strip():
                raise CairnError(f"ticket {t[0]} is claimed by {meta.get('assignee')}")
            return t[0], path, title, text
    raise CairnError(f"unknown ticket: {tid}")


def set_frontmatter(text, key, value):
    lines = text.replace("\r\n", "\n").split("\n")
    end = next((i for i in range(1, len(lines)) if lines[i].strip() == "---"), None)
    if not lines or lines[0].strip() != "---" or end is None:
        raise CairnError("ticket has no frontmatter")
    line = f"{key}: {value}".rstrip()
    for i in range(1, end):
        if re.match(rf"^{key}\s*:", lines[i]):
            # a block-style list continues on indented "- x" lines
            j = i + 1
            while j < end and re.match(r"^\s*-(\s|$)", lines[j]):
                j += 1
            lines[i:j] = [line]
            return "\n".join(lines)
    lines.insert(end, line)
    return "\n".join(lines)


def add_map_line(text, heading, line):
    """Append `line` to the end of the `## heading` section, creating it if absent."""
    lines = text.replace("\r\n", "\n").rstrip("\n").split("\n")
    start = next((i for i, l in enumerate(lines)
                  if re.match(r"^##\s+(.*?)\s*$", l)
                  and re.match(r"^##\s+(.*?)\s*$", l).group(1).lower() == heading.lower()), None)
    if start is None:
        return "\n".join(lines + ["", f"## {heading}", "", line]) + "\n"
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    last = start
    for i in range(start + 1, end):
        if lines[i].strip():
            last = i
    if last == start:
        lines[start + 1:end] = ["", line] + ([""] if end < len(lines) else [])
    else:
        lines.insert(last + 1, line)
    return "\n".join(lines) + "\n"


def head_holds(repo, rel):
    """True when HEAD has exactly the working-tree content of `rel` (or both lack it)."""
    r = run(["git", "rev-parse", "-q", "--verify", f"HEAD:{rel}"], cwd=repo)
    in_head = r.stdout.strip() if r.returncode == 0 else None
    if not (repo / rel).exists():
        return in_head is None
    r = run(["git", "hash-object", "--", rel], cwd=repo)
    return r.returncode == 0 and r.stdout.strip() == in_head


def git_commit(repo, message, paths):
    """Stage and commit only `paths`, without the repo's hooks or signing (a slow hook would outlast the timeout);
    staged changes elsewhere stay staged. `git commit -- <paths>` builds the commit from HEAD plus just those paths.
    A failed commit still succeeds when HEAD already holds every path, which
    is what happens when a lead commit takes the files first."""
    env = dict(os.environ, GIT_AUTHOR_NAME=DASHBOARD_IDENTITY[0], GIT_AUTHOR_EMAIL=DASHBOARD_IDENTITY[1],
               GIT_COMMITTER_NAME=DASHBOARD_IDENTITY[0], GIT_COMMITTER_EMAIL=DASHBOARD_IDENTITY[1])
    tries = int(os.environ.get("CAIRN_LOCK_TRIES", LOCK_TRIES))
    delay = float(os.environ.get("CAIRN_LOCK_DELAY", LOCK_DELAY))
    commit = ["-c", "commit.gpgsign=false", "commit", "--no-verify"]
    try:
        for name, step in (("add", ["add", "--"]), ("commit", [*commit, "-m", message, "--"])):
            for attempt in range(tries):
                r = run(["git", *step, *paths], cwd=repo, env=env)
                if r.returncode == 0:
                    break
                err = (r.stderr or r.stdout).strip()
                if not any(m in err for m in LOCK_ERRORS) or attempt == tries - 1:
                    raise CairnError(f"git {name} failed: {err}")
                time.sleep(delay)
    except CairnError:
        if not all(head_holds(repo, p) for p in paths):
            raise
    r = run(["git", "rev-parse", "--short", "HEAD"], cwd=repo)
    if r.returncode != 0:
        raise CairnError(f"git rev-parse failed: {(r.stderr or r.stdout).strip()}")
    return r.stdout.strip()


def cmd_ticket(args):
    if len(args) != 1:
        raise CairnError("usage: ticket <project>")
    repo = project_path(args[0])
    try:
        op = json.loads(sys.stdin.read())
    except ValueError as e:
        raise CairnError(f"ticket op is not valid JSON: {e}")
    if not isinstance(op, dict):
        raise CairnError("ticket op must be a JSON object")
    name = op.get("op")
    if name not in ("create", "close", "out-of-scope", "blockers"):
        raise CairnError("op must be create, close, out-of-scope or blockers")
    if not (repo / ".git").exists():
        raise CairnError(f"{repo} is not a git repo")
    with ticket_lock(repo):
        return apply_ticket_op(repo, name, op)


def apply_ticket_op(repo, name, op):
    found = load_ticket_files(repo)
    known = {norm_id(t[0]) for t in found}
    writes = {}  # path -> new text
    mappath = repo / "work" / "map.md"

    if name == "create":
        title = one_line(need_text(op, "title"))
        ttype = op.get("type")
        if ttype not in TICKET_TYPES:
            raise CairnError(f"type must be one of {', '.join(TICKET_TYPES)}")
        question = op.get("question")
        if not isinstance(question, str):
            raise CairnError("question is required")
        blocked = check_blockers(op.get("blocked_by"), known)
        tid = next_ticket_id(repo, found)
        check_no_cycle(found, tid, blocked)
        path = repo / "work" / "tickets" / f"{tid}-{slugify(title)}.md"
        if path.exists():
            raise CairnError(f"{path.relative_to(repo)} already exists")
        writes[path] = (f"---\nid: {tid}\ntitle: {json.dumps(title, ensure_ascii=False)}\ntype: {ttype}\n"
                        f"status: open\nassignee:\nblocked_by: [{', '.join(blocked)}]\n---\n## Question\n\n"
                        f"{question.strip()}\n")
    elif name in ("close", "out-of-scope"):
        key = "resolution" if name == "close" else "reason"
        if "id" not in op:
            raise CairnError("id is required")
        text_in = need_text(op, key)
        tid, path, title, text = open_unclaimed(found, op["id"])
        # The lead also writes the map; never commit its unfinished edits.
        if not head_holds(repo, "work/map.md"):
            raise CairnError("work/map.md has uncommitted changes from the lead; retry in a moment")
        body = text_in if name == "close" else f"Out of scope: {text_in}"
        new = set_frontmatter(text, "status", "closed").rstrip("\n") + f"\n\n## Resolution\n\n{body}\n"
        writes[path] = new
        mtext = read_file(mappath, errors="strict", whole=True) if mappath.exists() else ""
        heading = "Decisions so far" if name == "close" else "Out of scope"
        writes[mappath] = add_map_line(
            mtext, heading, f"- [{title}](tickets/{path.name}) — {one_line(text_in)}")
    else:
        if "id" not in op:
            raise CairnError("id is required")
        tid, path, title, text = open_unclaimed(found, op["id"])
        if "blocked_by" not in op:
            raise CairnError("blocked_by is required")
        blocked = check_blockers(op["blocked_by"], known, tid)
        check_no_cycle(found, tid, blocked)
        writes[path] = set_frontmatter(text, "blocked_by", f"[{', '.join(blocked)}]")

    # read_file refuses a symlink, so a write below never lands outside the repo
    before = {p: (read_file(p, errors="strict", whole=True) if p.exists() else None) for p in writes}
    rels = [str(p.relative_to(repo)) for p in writes]
    try:
        for p, t in writes.items():
            try:
                with open(p, "x" if before[p] is None else "w") as fh:
                    fh.write(t)
            except FileExistsError:
                raise CairnError(f"{p.relative_to(repo)} already exists")
        sha = git_commit(repo, f"cairn: {name} ticket {tid}", rels)
    except BaseException:   # also an OSError, such as a read-only work/map.md
        # Undo only our own uncommitted writes: never touch a path whose
        # content HEAD already holds or that someone else has since changed.
        undone = []
        for p, old in before.items():
            rel = str(p.relative_to(repo))
            if not p.exists() or p.read_text() != writes[p] or head_holds(repo, rel):
                continue
            if old is None:
                p.unlink()
            else:
                p.write_text(old)
            undone.append(rel)
        if undone:
            run(["git", "reset", "-q", "--", *undone], cwd=repo)
        raise
    ticket_path = next(p for p in writes if p != mappath)
    return {"id": tid, "path": str(ticket_path.relative_to(repo)), "commit": sha}


# ---------- start / stop / review / pane ----------

def load_session_id(project):
    try:
        data = json.loads(marker(project).read_text())
        return str(uuid.UUID(str(data["session_id"])))
    except (OSError, ValueError, TypeError, KeyError):
        return None


def transcript_saved(sid):
    """Whether claude still has conversation `sid` (~/.claude/projects/<folder>/<sid>.jsonl)."""
    return any((home() / ".claude" / "projects").glob(f"*/{sid}.jsonl"))


def take_models(args):
    """Strip --model and --subagent-model from args; each value must be one of MODELS."""
    rest, found = list(args), {}
    for flag in ("--model", "--subagent-model"):
        if flag in rest:
            i = rest.index(flag)
            if i + 1 >= len(rest) or rest[i + 1] not in MODELS:
                raise CairnError(f"{flag} must be one of {', '.join(MODELS)}")
            found[flag] = rest[i + 1]
            del rest[i:i + 2]
    return rest, found.get("--model"), found.get("--subagent-model")


def cmd_start(args):
    rest, model, subagent_model = take_models(args)
    if len(rest) != 1:
        raise CairnError("usage: start <project> [--model A] [--subagent-model A]")
    project = rest[0]
    path = project_path(project)
    token = read_token()
    if session_alive(project):
        raise CairnError(f"session {project} is already running")
    sid = load_session_id(project)
    if sid and not transcript_saved(sid):   # claude --resume of a conversation it no longer has exits at once
        sid = None
    resumed = sid is not None
    cargs = ["--model", model] if model else []
    if resumed:
        cargs += ["--resume", sid]
    else:
        sid = str(uuid.uuid4())
        cargs += ["--session-id", sid]
    try:
        before = marker(project).read_text()
    except OSError:
        before = None

    def started():
        marker(project).parent.mkdir(parents=True, exist_ok=True)
        marker(project).write_text(json.dumps({"session_id": sid, "started_at": now_iso()}) + "\n")

    try:
        new_session(project, path, token, cargs, CONTINUE_PROMPT if resumed else START_PROMPT, subagent_model, started)
    except BaseException:
        if session_alive(project) is False:   # no lead runs: keep the marker of the last one that did
            if before is None:
                marker(project).unlink(missing_ok=True)
            else:
                marker(project).write_text(before)
        raise
    return {"session": project, "resumed": resumed, "session_id": sid}


def cmd_stop(args):
    if len(args) != 1:
        raise CairnError("usage: stop <project>")
    project_path(args[0])
    if session_alive(args[0]) is False:
        return {"stopped": False}
    r = tmux("kill-session", "-t", f"={args[0]}")
    if r.returncode != 0:
        if session_alive(args[0]) is False:   # the lead ended its own session in between
            return {"stopped": False}
        raise CairnError(f"tmux kill-session failed: {(r.stderr or '').strip()}")
    try:   # a deliberate stop, so the hub does not report "stopped while working"; start rewrites the marker
        data = json.loads(marker(args[0]).read_text())
        marker(args[0]).write_text(json.dumps(dict(data, stopped=True)) + "\n")
    except (OSError, ValueError):
        pass
    return {"stopped": True}


def cmd_review(args):
    if len(args) != 1:
        raise CairnError("usage: review <project>")
    project = args[0]
    path = project_path(project)
    token = read_token()
    name = project + REVIEW_SUFFIX
    if not session_alive(name):
        new_session(name, path, token, ["--session-id", str(uuid.uuid4())], REVIEW_PROMPT)
    return {"session": name, "attach": f"tmux -L cairn attach -t {name}"}


def read_token_fd():
    """The token line, read byte by byte from fd 0 so the rest of stdin stays for claude."""
    buf = bytearray()
    while len(buf) < 16384:
        b = os.read(0, 1)
        if not b or b == b"\n":
            break
        buf += b
    token = buf.decode(errors="replace").strip()
    if any(c.isspace() for c in token):
        raise CairnError("token must not contain whitespace")
    return token


def review_marker(project):
    return cairn_home() / "state" / f"{project}.review.json"


def cmd_chat(args):
    rest, model, subagent_model = take_models(args)
    resume = "--resume" in rest
    rest = [a for a in rest if a != "--resume"]
    if len(rest) != 1:
        raise CairnError("usage: chat <project> [--resume] [--model A] [--subagent-model A]")
    project = rest[0]
    path = project_path(project)
    token = read_token_fd()
    claude = resolve_claude()
    if not claude:
        raise CairnError("claude not found on PATH or in ~/.local/bin")
    trust_project(path)
    sid = None
    if resume:
        try:
            sid = str(uuid.UUID(str(json.loads(review_marker(project).read_text())["session_id"])))
        except (OSError, ValueError, TypeError, KeyError):
            sid = None
        # The marker is written before claude runs; resume only a conversation claude saved.
        if sid and not transcript_saved(sid):
            sid = None
    resumed = sid is not None
    if not resumed:
        sid = str(uuid.uuid4())
        review_marker(project).parent.mkdir(parents=True, exist_ok=True)
        review_marker(project).write_text(json.dumps({"session_id": sid, "started_at": now_iso()}) + "\n")
    env = {k: v for k, v in os.environ.items() if k not in (TOKEN_VAR, SUBAGENT_VAR)}
    if token:
        env[TOKEN_VAR] = token
    if subagent_model:
        env[SUBAGENT_VAR] = subagent_model
    argv = [claude, "-p", "--input-format", "stream-json", "--output-format", "stream-json",
            "--verbose", "--dangerously-skip-permissions", *(["--model", model] if model else []),
            "--resume" if resumed else "--session-id", sid]
    sys.stdout.write(json.dumps({"type": "cairn", "session_id": sid, "resumed": resumed}) + "\n")
    sys.stdout.flush()
    os.chdir(path)
    os.execve(claude, argv, env)


def cmd_answer(args):
    if len(args) != 1:
        raise CairnError("usage: answer <project>  (stdin: {\"id\", \"choice\", \"note\", \"fingerprint\"})")
    path = project_path(args[0])
    try:
        op = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        raise CairnError("stdin is not JSON")
    if not isinstance(op, dict):
        raise CairnError("stdin must be a JSON object")
    qid, choice, note, fingerprint = op.get("id"), op.get("choice"), op.get("note") or "", op.get("fingerprint")
    if not isinstance(qid, str) or not re.fullmatch(r"q\d+", qid):
        raise CairnError(f"invalid question id: {qid!r}")
    if not isinstance(note, str) or len(note) > 4000:
        raise CairnError("note must be text of at most 4000 characters")
    if fingerprint is not None and not isinstance(fingerprint, str):
        raise CairnError("fingerprint must be text")
    question = next((q for q in read_questions(path, [], args[0]) if q["id"] == qid), None)
    if question is None:
        raise CairnError(f"unknown question: {qid}")
    if fingerprint is not None and fingerprint != question["fingerprint"]:   # absent from older hubs
        raise CairnError(f"{qid} changed since it was shown; read it again", question=question)
    if question["answered"]:
        raise CairnError(f"{qid} is already answered")
    letters = [OPTION_RE.match(o).group(1) for o in question["options"]]
    if choice == "other":
        if not note.strip():
            raise CairnError("choice other needs a note")
    elif choice not in letters:
        raise CairnError(f"choice must be one of {', '.join(letters + ['other'])}")
    at = now_iso()
    rel = f"work/inbox/{Path(question['path']).stem}.answer.md"
    text = f"---\nid: {qid}\nchoice: {choice}\nanswered_at: {at}\n---\n{note.strip()}\n"
    try:
        fd = os.open(path / rel, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    except FileExistsError:
        raise CairnError(f"{qid} is already answered")
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
    return {"id": qid, "choice": choice, "answered_at": at, "path": rel}


def cmd_pane(args):
    review = "--review" in args
    rest = [a for a in args if a != "--review"]
    if len(rest) != 1:
        raise CairnError("usage: pane <project> [--review]")
    project_path(rest[0])
    name = rest[0] + REVIEW_SUFFIX if review else rest[0]
    if session_alive(name) is False:
        raise CairnError(f"no session {name}")
    lines = pane_lines(name)
    if lines is None:
        raise CairnError(f"tmux capture-pane failed for {name}")
    return {"lines": lines}


ANSWER_HOLD = 15   # seconds; Claude Code may still show a dialog it took, and a second Enter would answer the next one
KEY_GAP = 0.15   # one send-keys per key, spaced, so Claude Code never sees a burst it might read as one input
MOVE_WAIT = 1.5


def lead_dialog(project):
    project_path(project)
    if session_alive(project) is False:
        raise CairnError(f"no session {project}")
    lines = pane_lines(project, DIALOG_LINES)
    if lines is None:
        raise CairnError(f"tmux capture-pane failed for {project}")
    return read_dialog(lines)


def send_key(project, key):
    if tmux("send-keys", "-t", f"={project}:", key).returncode != 0:
        raise CairnError(f"tmux send-keys failed for {project}")


def wait_dialog(project, seconds, done, gone_ok=False):
    deadline = time.monotonic() + seconds
    while True:
        try:
            dialog = lead_dialog(project)
        except CairnError:
            if gone_ok and session_alive(project) is False:
                return None
            raise
        if done(dialog) or time.monotonic() >= deadline:
            return dialog
        time.sleep(0.2)


@contextlib.contextmanager
def dialog_lock(project):
    """One answer per lead at a time. The file also records the last answered dialog text and when."""
    path = cairn_home() / "state" / f"{project}.dialog.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise CairnError("another answer to this dialog is being sent; read it again", dialog=lead_dialog(project))
        yield fd
    finally:
        os.close(fd)


def dialog_text(dialog):
    """The dialog without its ❯ marker: the same text whichever option is selected."""
    return hashlib.sha256("\n".join(l.replace("❯", " ") for l in steady(dialog["lines"])).encode()).hexdigest()


def cmd_dialog(args):
    if len(args) != 1:
        raise CairnError("usage: dialog <project>")
    return {"dialog": lead_dialog(args[0])}


def cmd_dialog_answer(args):
    """Pick option n of the lead's dialog, only while the pane shows exactly the dialog with that fingerprint.
    The ❯ marker is moved with Up/Down and checked before Enter; number keys are never sent."""
    if len(args) != 3 or not re.fullmatch(r"[0-9a-f]{64}", args[1]) or not args[2].isdigit():
        raise CairnError("usage: dialog-answer <project> <fingerprint> <n>")
    project, fingerprint, n = args[0], args[1], int(args[2])
    project_path(project)
    with dialog_lock(project) as fd:
        dialog = lead_dialog(project)
        if dialog is None or dialog["fingerprint"] != fingerprint:
            raise CairnError("the dialog changed; read it again", dialog=dialog)
        option = next((o for o in dialog["options"] if o["n"] == n), None)
        if option is None:
            raise CairnError(f"option {n} is not one of the dialog's options", dialog=dialog)
        try:
            last = json.loads(os.pread(fd, 4096, 0) or b"{}")
        except ValueError:
            last = {}
        text = dialog_text(dialog)
        if last.get("text") == text and time.time() - last.get("at", 0) < ANSWER_HOLD:
            raise CairnError("this dialog was answered moments ago; read it again in a few seconds", dialog=dialog)
        key = "Down" if n > dialog["selected"] else "Up"
        for _ in range(abs(n - dialog["selected"])):
            send_key(project, key)
            time.sleep(KEY_GAP)
        same = lambda d: d is not None and dialog_text(d) == text
        moved = wait_dialog(project, MOVE_WAIT, lambda d: not same(d) or d["selected"] == n)
        if not same(moved) or moved["selected"] != n:
            raise CairnError(f"the selection did not reach option {n}; nothing was confirmed", dialog=moved)
        os.ftruncate(fd, 0)
        os.pwrite(fd, json.dumps({"text": text, "at": time.time()}).encode(), 0)
        send_key(project, "Enter")
        wait = float(os.environ.get("CAIRN_DIALOG_WAIT", 3))
        after = wait_dialog(project, wait, lambda d: d is None or d["fingerprint"] != moved["fingerprint"], gone_ok=True)
    return {"answered": n, "label": option["label"], "dialog": after}


# ---------- relead / usage ----------

def lead_section(text, heading, until):
    """The text under `## <heading>` up to the template's next heading `## <until>` (so notes may hold their own
    `## ` headings); None when either heading is missing."""
    m = re.search(rf"^## {heading}[ \t]*\n(.*?)^## {until}[ \t]*$", text, re.M | re.S)
    return m.group(1).strip() if m else None


def headings(text):
    return [l[3:].strip() for l in text.splitlines() if l.startswith("## ")]


def cmd_relead(args):
    """Re-render LEAD.md from the current template, keeping the destination and notes."""
    if len(args) != 1:
        raise CairnError("usage: relead <project>")
    project = args[0]
    repo = project_path(project)
    try:
        current = read_file(repo / "LEAD.md", errors="strict", whole=True)
    except (OSError, ValueError) as e:
        raise CairnError(f"cannot read LEAD.md: {e}")
    destination, notes = lead_section(current, "Destination", "Notes"), lead_section(current, "Notes", "Files")
    if destination is None or notes is None:
        raise CairnError("LEAD.md has no ## Destination, ## Notes or ## Files heading; edit it by hand")
    template = find_template().read_text()
    version = template_version() or 1
    new = render(template, {"project": project, "destination": destination, "notes": notes or "None."})
    known = set(headings(new))
    kept = current[current.index("## Destination"):current.index("## Files")]
    dropped = [h for h in headings(current) if h not in known and h not in headings(kept)]
    (repo / "LEAD.md").write_text(new)
    try:
        sha = git_commit(repo, f"cairn: update LEAD.md to v{version}", ["LEAD.md"])
    except BaseException:
        (repo / "LEAD.md").write_text(current)
        run(["git", "reset", "-q", "--", "LEAD.md"], cwd=repo)
        raise
    return {"version": version, "commit": sha, "dropped": dropped}


ACTIVE_GAP = 300  # seconds; longer gaps between transcript entries are not active time


def parse_ts(text):
    try:
        return datetime.fromisoformat(str(text).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def usage_of_file(path):
    """{"messages": {id: [model, input, output, cache_read, cache_write]}, "times": [ISO, ...]} for one transcript."""
    messages, times = {}, []
    with open(path, errors="replace") as f:
        for line in f:
            try:
                m = json.loads(line)
            except ValueError:
                continue
            if not isinstance(m, dict):
                continue
            if isinstance(m.get("timestamp"), str):
                times.append(m["timestamp"])
            msg = m.get("message") if m.get("type") == "assistant" else None
            if not isinstance(msg, dict) or not isinstance(msg.get("usage"), dict) or msg.get("model") in (None, "<synthetic>"):
                continue
            u = msg["usage"]
            try:
                counts = [int(u.get(k) or 0) for k in
                          ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")]
            except (TypeError, ValueError):
                continue
            messages[str(msg.get("id") or "%s:%d" % (path, len(messages)))] = [str(msg["model"]), *counts]
    return {"messages": messages, "times": times}


def cached_usage(entry, stamp):
    """True when a cache entry is for this stamp and has the shape usage_of_file returns."""
    if not isinstance(entry, dict) or entry.get("stamp") != stamp:
        return False
    rows, times = entry.get("messages"), entry.get("times")
    return (isinstance(rows, dict) and isinstance(times, list) and all(isinstance(t, str) for t in times)
            and all(isinstance(r, list) and len(r) == 5 and isinstance(r[0], str)
                    and all(type(v) is int for v in r[1:]) for r in rows.values()))


def cmd_usage(args):
    if len(args) != 1:
        raise CairnError("usage: usage <project>")
    project = args[0]
    repo = project_path(project)
    # Claude Code names the folder after its real working directory; try the registered path too
    roots = list(dict.fromkeys(home() / ".claude" / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(p))
                               for p in (repo, repo.resolve())))
    cache_path = cairn_home() / "state" / f"usage-{project}.json"
    try:
        cache = json.loads(cache_path.read_text())
    except (OSError, ValueError):
        cache = {}
    if not isinstance(cache, dict):
        cache = {}
    fresh, messages, times, sessions = {}, {}, [], 0
    paths = [(root, p) for root in roots if root.is_dir() for p in sorted(root.rglob("*.jsonl"))]
    for root, path in paths:
        key = str(path.relative_to(root.parent))
        try:   # a transcript can go between the listing and its read
            st = path.stat()
            stamp = [st.st_size, st.st_mtime]
            entry = cache.get(key)
            if not cached_usage(entry, stamp):
                entry = {"stamp": stamp, **usage_of_file(path)}
        except OSError:
            continue
        fresh[key] = entry
        sessions += path.parent in roots
        messages.update(entry["messages"])
        times += entry["times"]
    cache_path.parent.mkdir(parents=True, exist_ok=True)
    tmp = cache_path.with_name(f"{cache_path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(fresh))
    os.replace(tmp, cache_path)
    models = {}
    for model, *counts in messages.values():
        row = models.setdefault(model, {"model": model, "input": 0, "output": 0, "cache_read": 0, "cache_write": 0, "messages": 0})
        for k, v in zip(("input", "output", "cache_read", "cache_write"), counts):
            row[k] += v
        row["messages"] += 1
    stamps = sorted(t for t in (parse_ts(x) for x in times) if t is not None)
    active = sum(b - a for a, b in zip(stamps, stamps[1:]) if b - a < ACTIVE_GAP)
    by_time = sorted(times, key=lambda x: parse_ts(x) or 0)
    return {"models": sorted(models.values(), key=lambda r: -r["output"]), "sessions": sessions,
            "first_at": by_time[0] if by_time else None, "last_at": by_time[-1] if by_time else None,
            "active_minutes": int(active // 60), "files": len(fresh)}


COMMANDS = {"snapshot": cmd_snapshot, "read": cmd_read, "init": cmd_init,
            "start": cmd_start, "stop": cmd_stop, "review": cmd_review, "pane": cmd_pane,
            "ticket": cmd_ticket, "chat": cmd_chat, "answer": cmd_answer,
            "relead": cmd_relead, "usage": cmd_usage, "dialog": cmd_dialog, "dialog-answer": cmd_dialog_answer}


def main(argv):
    # the registry, session ids and usage are nobody else's business; git, tmux and claude inherit this too
    os.umask(0o077)
    try:
        if not argv or argv[0] not in COMMANDS:
            raise CairnError("usage: cairn-node " + "|".join(COMMANDS))
        result = COMMANDS[argv[0]](argv[1:])
    except CairnError as e:
        print(json.dumps({"error": str(e), **e.extra}))
        return 1
    except Exception as e:
        print(json.dumps({"error": f"{type(e).__name__}: {e}"}))
        return 1
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
