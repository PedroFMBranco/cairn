def cmd_read(args):
    if len(args) != 2:
        raise CairnError("usage: read <project> <relpath>")
    repo = project_path(args[0]).resolve()
    target = (repo / args[1]).resolve()
    if target != repo and repo not in target.parents:
        raise CairnError("path escapes the repo")
    if not target.is_file():
        raise CairnError(f"not a file: {args[1]}")
    if target.stat().st_size > MAX_READ_BYTES:
        raise CairnError("file too large")
    return {"path": args[1], "content": read_file(target)}


