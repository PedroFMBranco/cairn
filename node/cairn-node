class CairnError(Exception):
    def __init__(self, message, **extra):
        super().__init__(message)
        self.extra = extra


def home():
    return Path(os.environ.get("HOME") or os.path.expanduser("~"))


def cairn_home():
    return home() / ".cairn"


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_file(path, limit=MAX_READ_BYTES, errors="replace", whole=False):
    """At most `limit` bytes of the regular file at `path`, as text. A lead owns the repo, so never through a
    symlink and never blocking on a FIFO: anything but a regular file raises OSError. With `whole`, a longer file
    raises OSError too, for callers that write the text back."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError(errno.EINVAL, "not a regular file", str(path))
        data = f.read(limit + 1 if whole else limit)
    if len(data) > limit:
        raise OSError(errno.EFBIG, "file too large", str(path))
    return data.decode(errors=errors)


def run(argv, cwd=None, stdin=None, timeout=15, env=None):
    try:
        return subprocess.run(argv, cwd=cwd, input=stdin, capture_output=True,
                              text=True, timeout=timeout, env=env)
    except FileNotFoundError:
        raise CairnError(f"{argv[0]} not found")
    except subprocess.TimeoutExpired:
        raise CairnError(f"{argv[0]} timed out")


# ---------- frontmatter ----------

DQ_RE = re.compile(r'^"((?:[^"\\]|\\.)*)"\s*(?:#.*)?$')
SQ_RE = re.compile(r"^'((?:[^']|'')*)'\s*(?:#.*)?$")


def parse_scalar(raw):
    raw = raw.strip()
    m = DQ_RE.match(raw)
    if m:
        try:
            return json.loads(f'"{m.group(1)}"')
        except ValueError:
            return m.group(1)
    m = SQ_RE.match(raw)
    if m:
        return m.group(1).replace("''", "'")
    m = re.search(r"\s#", raw)
    if m:
        raw = raw[:m.start()].rstrip()
    if raw.startswith("#"):
        return ""
    if raw in ("null", "~"):
        return ""
    if raw.startswith("[") and raw.endswith("]"):
        inner = raw[1:-1].strip()
        return [parse_scalar(p) for p in inner.split(",") if p.strip()] if inner else []
    if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'":
        return raw[1:-1]
    return raw


def parse_frontmatter(text):
    """Return (meta, body). Raises ValueError on an unclosed block."""
    text = text.lstrip("﻿").replace("\r\n", "\n")
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return {}, text
    end = next((i for i in range(1, len(lines)) if lines[i].strip() == "---"), None)
    if end is None:
        raise ValueError("frontmatter is not closed")
    meta, key = {}, None
    for line in lines[1:end]:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        item = re.match(r"^\s+-\s*(.*)$", line) or re.match(r"^-\s+(.*)$", line)
        if item and key is not None and meta.get(key) in ("", []):
            if meta[key] == "":
                meta[key] = []
            meta[key].append(parse_scalar(item.group(1)))
            continue
        m = re.match(r"^([A-Za-z_][\w-]*)\s*:\s*(.*)$", line)
        if m:
            key = m.group(1)
            meta[key] = parse_scalar(m.group(2))
    return meta, "\n".join(lines[end + 1:])


def as_list(value):
    if isinstance(value, list):
        return [str(v) for v in value if str(v)]
    return [str(value)] if value else []


def norm_id(value):
    value = str(value).strip()
    return value.lstrip("0") or "0" if value.isdigit() else value


def truthy(value):
    return str(value).strip().lower() in ("yes", "true", "y", "1")


# ---------- registry ----------

def load_projects():
    path = cairn_home() / "projects.json"
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError) as e:
        raise CairnError(f"cannot read {path}: {e}")
    return data if isinstance(data, dict) else {}


def update_projects(change):
    """Apply change(projects) to the registry and save it, reloading under a lock first so that an init that
    finishes while another one clones never loses its entry. Returns what change returns."""
    ch = cairn_home()
    ch.mkdir(parents=True, exist_ok=True)
    fd = os.open(ch / "projects.lock", os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        data = load_projects()
        result = change(data)
        tmp = ch / f"projects.json.{os.getpid()}.tmp"
        tmp.write_text(json.dumps(data, indent=2) + "\n")
        os.replace(tmp, ch / "projects.json")
        return result
    finally:
        os.close(fd)


def project_path(project):
    if not NAME_RE.match(project or ""):
        raise CairnError(f"invalid project name: {project!r}")
    entry = load_projects().get(project)
    if not entry or not entry.get("path"):
        raise CairnError(f"unknown project: {project}")
    path = Path(entry["path"])
    if not path.is_dir():
        raise CairnError(f"project path missing: {path}")
    return path


def marker(project):
    return cairn_home() / "state" / f"{project}.started"


# ---------- tmux ----------

def tmux_env():
    # A cairn-node run from inside a session (a lead or review pane) has
    # the token in its environment; keep it out of the tmux server's.
    return {k: v for k, v in os.environ.items() if k != TOKEN_VAR}


def tmux(*args, stdin=None, timeout=None):
    timeout = timeout or float(os.environ.get("CAIRN_TMUX_TIMEOUT", TMUX_TIMEOUT))
    return run(["tmux", "-L", "cairn", *args], stdin=stdin, env=tmux_env(), timeout=timeout)


def session_alive(name, timeout=None):
    """True or False; None when tmux did not answer (timed out, not found), which proves neither."""
    try:
        return tmux("has-session", "-t", f"={name}", timeout=timeout).returncode == 0
    except CairnError:
        return None


def read_token():
    line = sys.stdin.readline()
    token = line.strip()
    if any(c.isspace() for c in token):
        raise CairnError("token must not contain whitespace")
    return token


def resolve_claude():
    found = shutil.which("claude")
    if found:
        return os.path.abspath(found)
    local = home() / ".local" / "bin" / "claude"
    if local.is_file() and os.access(local, os.X_OK):
        return str(local)
    return None


def require_tmux():
    try:
        r = run(["tmux", "-V"], timeout=5)
    except CairnError:
        raise CairnError("tmux not found")
    m = re.search(r"(\d+)\.(\d+)", r.stdout or r.stderr or "")
    if not m:
        raise CairnError(f"cannot read the tmux version: {(r.stdout or r.stderr).strip()!r}")
    if (int(m.group(1)), int(m.group(2))) < MIN_TMUX:
        raise CairnError(f"tmux 3.2 or later is required, found {m.group(0)}")


def file_version(path):
    try:
        st = os.stat(path)
    except FileNotFoundError:
        return None
    return st.st_ino, st.st_mtime_ns, st.st_size


def trust_project(path):
    """Merge onboarding, bypass-permissions and folder trust into ~/.claude.json. A running claude also writes the
    file, so the merge starts again when the file changed while it ran (this narrows the race; it cannot close it)."""
    cfg = home() / ".claude.json"
    for _ in range(TRUST_TRIES):
        seen = file_version(cfg)
        if merge_trust(cfg, path, seen):
            return
    raise CairnError(f"{cfg} kept changing while cairn-node merged its settings; try again")


def merge_trust(cfg, path, seen):
    """One merge; False when the file is no longer the version `seen`, and nothing was written."""
    data = {}
    if seen is not None:
        try:
            data = json.loads(cfg.read_text() or "{}")
        except (OSError, ValueError) as e:
            raise CairnError(f"cannot read {cfg}: {e}")
        if not isinstance(data, dict):
            raise CairnError(f"{cfg} is not a JSON object")
    before = json.dumps(data, sort_keys=True)
    data["hasCompletedOnboarding"] = True
    data["bypassPermissionsModeAccepted"] = True
    projects = data.get("projects")
    if not isinstance(projects, dict):
        projects = data["projects"] = {}
    for p in {str(path), str(Path(path).resolve())}:
        entry = projects.get(p)
        if not isinstance(entry, dict):
            entry = projects[p] = {}
        entry["hasTrustDialogAccepted"] = True
    if json.dumps(data, sort_keys=True) == before:
        return True
    mode = cfg.stat().st_mode & 0o777 if cfg.exists() else 0o600
    tmp = cfg.with_name(f".claude.json.cairn-{os.getpid()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps(data, indent=2) + "\n")
    if file_version(cfg) != seen:
        os.unlink(tmp)
        return False
    os.replace(tmp, cfg)
    return True


def redact(text, token):
    return text.replace(token, "***") if token else text


TOKEN_RE = re.compile(r"sk-ant-[A-Za-z0-9_-]+")


def pane_lines(name, count=60, timeout=None):
    """The pane's last `count` lines, with anything shaped like an Anthropic token replaced by ***: the node does
    not know the token here, and the lines reach the dashboard (pane, dialog, pane_last, lead_note)."""
    r = tmux("capture-pane", "-p", "-t", f"={name}:", "-S", f"-{count}", timeout=timeout)
    if r.returncode != 0:
        return None
    lines = TOKEN_RE.sub("***", r.stdout).split("\n")
    while lines and not lines[-1].strip():
        lines.pop()
    return lines[-count:]


BOX_CHARS = set("─━│┃╭╮╰╯┌┐└┘═║╔╗╚╝ ")
PANE_CHROME = ("bypass permissions", "shift+tab", "? for shortcuts", "auto-accept edits", "Try \"")


LIMIT_RE = re.compile(r"usage limit|hit your (session |weekly |daily |opus |sonnet |fable )?limit|"
                      r"reached your .{0,20}limit|limit reached|resets (at|in) ", re.I)
RESET_TIME_RE = re.compile(r"\bresets\s+(at\s+|in\s+)?\d|automatically at\s+\d", re.I)
ZONE_RE = re.compile(r"\d\s*(am|pm)?\s*\([A-Za-z_/+-]+\)", re.I)
CLOCK_RE = re.compile(r"(?:resets\s+(?:at\s+)?|automatically at\s+)\d{1,2}(?::\d{2})?(?:\s*[ap]m)?", re.I)
ZONE_NAME_RE = re.compile(r"^(UTC|GMT|[A-Za-z_]+(?:/[A-Za-z_+-]+)+)$")
DIALOG_RE = re.compile(r"^\s*❯\s*1\.|Do you want to|Would you like to")
PROMPT_RE = re.compile(r"^\s*[│┃]?\s*[❯>]\s*[│┃]?\s*$")


STATE_LINES = 40
AGENTS_QUIET = 15 * 60   # seconds since a background agent last wrote before its lead counts as stopped


def pane_view(name):
    """(last line, lead state, note) from one capture of the lead's pane; all None when the capture fails,
    which never drops the project from the snapshot."""
    try:
        lines = pane_lines(name, STATE_LINES, timeout=3)
    except CairnError:
        lines = None
    if lines is None:
        return None, None, None
    return pane_last(lines), *lead_state(lines)


def agents_writing(name, repo):
    """Whether a background agent of the lead's session wrote its transcript in the last AGENTS_QUIET seconds."""
    sid = load_session_id(name)
    if not sid:
        return False
    since = time.time() - AGENTS_QUIET
    for p in dict.fromkeys((repo, repo.resolve())):
        folder = home() / ".claude" / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(p)) / sid / "subagents"
        try:
            if any(f.stat().st_mtime >= since for f in folder.glob("*.jsonl")):
                return True
        except OSError:
            pass
    return False


def clean_line(line):
    return line.strip().strip("│┃").strip()


def node_zone():
    """This node's zone as the hub reads it ("UTC" or an IANA name); None when it cannot be told."""
    name = (os.environ.get("TZ") or "").lstrip(":")
    if not ZONE_NAME_RE.match(name):
        try:
            link = os.path.realpath("/etc/localtime")
            name = link.split("zoneinfo/", 1)[1] if "zoneinfo/" in link else ""
        except OSError:
            name = ""
    if not ZONE_NAME_RE.match(name):
        try:
            name = Path("/etc/timezone").read_text().strip()
        except OSError:
            name = ""
    if ZONE_NAME_RE.match(name):
        return name
    return "UTC" if time.timezone == 0 and not time.daylight else None


def with_zone(note):
    """The note with this node's zone after a clock time that has none: Claude Code prints the time on the node's
    clock, and the hub would otherwise read it on the Mac's."""
    m = CLOCK_RE.search(note)
    zone = m and not re.match(r"\s*\(", note[m.end():]) and node_zone()
    return note[:m.end()] + " (%s)" % zone + note[m.end():] if zone else note


SPINNER_RE = re.compile(r"^\s*[✢✻✶✳✽✺·]\s+\S.*…\s*\(")   # "✻ Thinking… (12s · …"


def message_lines(tail):
    """How many lines at the top of `tail` are the lead's message: its ● line and the lines indented past the ●
    (its wrapped text and paragraphs), up to a ⎿ line or a line no deeper than the ●."""
    col, n = tail[0].index("●"), 1
    for i, l in enumerate(tail[1:], 1):
        if not l.strip():
            continue
        if len(l) - len(l.lstrip()) <= col or clean_line(l).startswith("⎿"):
            break
        n = i + 1
    return n


def lead_state(lines):
    """working, limit, dialog, prompt or unknown, with the line that says so. Only what follows the lead's last
    message (its last ● line above the input box) counts, so the lead's own words never read as a dialog or a limit,
    and the agent list under the box ("● main") is never taken for that message."""
    boxes = [i for i, l in enumerate(lines) if PROMPT_RE.match(l)]
    above = lines[:boxes[-1]] if boxes else lines
    bullets = [i for i, l in enumerate(above) if clean_line(l).startswith("●")]
    tail = lines[bullets[-1]:] if bullets else lines
    if any("esc to interrupt" in l or SPINNER_RE.match(l) for l in tail):
        return "working", None
    after = tail[message_lines(tail):] if bullets else tail   # the lead's message itself never reads as a limit
    limits = [clean_line(l) for l in after
              if (clean_line(l).startswith("⎿") and LIMIT_RE.search(l)) or ("limit" in l.lower() and "reset" in l.lower())]
    if limits:
        # the hub reads the reset time from the note: a line naming its zone beats the Mac's zone, and a "resets"
        # line beats the menu's "continue automatically at"
        timed = [(ZONE_RE.search(l) is not None, "resets" in l.lower(), i, l)
                 for i, l in enumerate(map(clean_line, after)) if RESET_TIME_RE.search(l)]
        if timed:
            return "limit", with_zone(max(timed)[3])[:200]
        return "limit", next((l for l in reversed(limits) if "reset" in l.lower()), limits[-1])[:200]
    box = any(PROMPT_RE.match(l) for l in tail)
    if not box and any(DIALOG_RE.search(l) for l in lines[-12:]):   # Claude Code's dialogs replace the input box
        return "dialog", next((clean_line(l)[:200] for l in reversed(lines[-12:]) if clean_line(l).endswith("?")), None)
    if box:
        return "prompt", None
    return "unknown", None


RULE_CHARS = set("─━╌╍┄┅┈┉═")
AUTO_DENY_RE = re.compile(r"will automatically deny this request in \d")
OPTION_LINE_RE = re.compile(r"^(\s*)(❯\s*)?(\d+)\.\s+(.*\S)\s*$")
DIALOG_LINES = 200


def read_dialog(lines):
    """The dialog the lead's pane shows, or None unless lead_state says dialog. The block runs from the
    dialog's top border (else the line after the lead's last ● line) to the end of the pane."""
    if lead_state(lines[-STATE_LINES:])[0] != "dialog":
        return None
    bullets = [i for i, l in enumerate(lines) if clean_line(l).startswith("●")]
    start = bullets[-1] + 1 if bullets else 0
    rule = next((i for i in range(start, len(lines)) if is_rule(lines[i])), None)
    block = [l.rstrip() for l in lines[start if rule is None else rule:]]
    while block and (not block[0].strip() or is_rule(block[0])):
        block.pop(0)
    while block and not block[-1].strip():
        block.pop()
    options, selected = dialog_options(block)
    return {"lines": block, "options": options, "selected": selected,
            "fingerprint": hashlib.sha256("\n".join(steady(block)).encode()).hexdigest()}


def steady(lines):
    """The dialog's lines without blanks and without Claude Code's auto-deny countdown, which ticks every second
    and goes (with its spacing) at the first key, so it never makes the same dialog look like a different one."""
    return [l for l in lines if l.strip() and not AUTO_DENY_RE.search(l)]


def is_rule(line):
    text = line.strip()
    return bool(text) and set(text) <= RULE_CHARS


def dialog_options(block):
    """([{"n", "label"}], n under the ❯ marker) from the numbered list that holds the marker; a label that wraps
    continues on lines indented past its number."""
    marked = next((i for i in range(len(block) - 1, -1, -1)
                   if (m := OPTION_LINE_RE.match(block[i])) and m.group(2)), None)
    if marked is None:
        return [], None
    first = next((i for i in range(marked, -1, -1) if (m := OPTION_LINE_RE.match(block[i])) and m.group(3) == "1"), None)
    if first is None:
        return [], None
    options, selected, col = [], None, 0
    for line in block[first:]:
        m = OPTION_LINE_RE.match(line)
        if m and int(m.group(3)) == len(options) + 1:
            options.append({"n": int(m.group(3)), "label": m.group(4)})
            col = len(m.group(1)) + len(m.group(2) or "")
            if m.group(2):
                selected = options[-1]["n"]
        elif options and line.strip() and len(line) - len(line.lstrip()) > col:
            options[-1]["label"] += " " + line.strip()
        else:
            break
    return (options, selected) if selected is not None else ([], None)


def pane_last(lines):
    """The lead's latest meaningful pane line (activity or output). Everything from Claude Code's
    input prompt down is the input box and footer, so the search starts above the last prompt."""
    prompts = [i for i, l in enumerate(lines) if l.strip().strip("│┃").strip().startswith((">", "❯"))]
    if prompts:
        lines = lines[:prompts[-1]]
    for line in reversed(lines):
        text = line.strip().strip("│┃").strip()
        if not text or set(text) <= BOX_CHARS or text.startswith((">", "❯")) or any(c in text for c in PANE_CHROME):
            continue
        return text[:160]
    return None


def deliver_token(fifo, token):
    deadline = time.monotonic() + float(os.environ.get("CAIRN_FIFO_TIMEOUT", FIFO_TIMEOUT))
    while True:
        try:
            fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
            break
        except OSError as e:
            if e.errno != errno.ENXIO or time.monotonic() > deadline:
                return False
            time.sleep(0.02)
    try:
        os.set_blocking(fd, True)
        os.write(fd, (token + "\n").encode())
    finally:
        os.close(fd)
    return True


def new_session(name, path, token, claude_args, prompt, subagent_model=None, started=None):
    """Start claude in tmux session `name` with `prompt`, token via FIFO; fail if it dies at once. `started` runs
    once claude has its token, before the watch, so a lead that outlives a failed watch is still on record."""
    require_tmux()
    claude = resolve_claude()
    if not claude:
        raise CairnError("claude not found on PATH or in ~/.local/bin")
    trust_project(path)
    rundir = cairn_home() / "run"
    rundir.mkdir(parents=True, exist_ok=True)
    os.chmod(rundir, 0o700)
    tdir = tempfile.mkdtemp(prefix=f"{name}-", dir=rundir)
    fifo = os.path.join(tdir, "token")
    try:
        os.mkfifo(fifo, 0o600)
        r = tmux("new-session", "-d", "-s", name, "-c", str(path), "--",
                 "/bin/sh", "-c", PANE_SH, "cairn-pane", fifo, subagent_model or "",
                 claude, "--dangerously-skip-permissions", *claude_args, prompt)
        if r.returncode != 0:
            err = (r.stderr or r.stdout or "tmux failed").strip()
            raise CairnError(f"tmux new-session failed: {redact(err, token)}")
        try:
            # The pane blocks on the FIFO until the token is written, so
            # remain-on-exit is on before claude can exit.
            tmux("set-option", "-w", "-t", f"={name}:", "remain-on-exit", "on")
            if not deliver_token(fifo, token):
                raise CairnError(f"session {name} did not read its token")
        except BaseException:
            # left alone, the pane waits forever on a FIFO that is about to go and reads as already running
            with contextlib.suppress(CairnError):
                tmux("kill-session", "-t", f"={name}")
            raise
    finally:
        shutil.rmtree(tdir, ignore_errors=True)
    if started:
        started()
    try:
        watch_start(name, token, prompt)
    finally:   # also after a failed watch, or the lead's dead pane would keep its session "running"
        with contextlib.suppress(CairnError):
            tmux("set-option", "-w", "-t", f"={name}:", "remain-on-exit", "off")


def prompt_echo(lines, prompt):
    """Index of the newest line where Claude Code echoes `prompt` (`❯ <prompt>`, its first wrapped line), or None."""
    for i in range(len(lines) - 1, -1, -1):
        text = lines[i].strip()
        if text.startswith("❯"):
            shown = text[1:].strip()
            if shown == prompt or (len(shown) >= 20 and prompt.startswith(shown)):
                return i
    return None


def login_failure(lines, prompt):
    """The pane line that says claude has no usable login for this start, or None. Only lines after the newest echo
    of this start's prompt count: a resumed lead replays its history first, and the lead's own words there may quote
    these messages (#35). The real failure follows the echo, as a `⎿` line, as the newest `●` line, or in the footer
    under the input box (node/tests/fixtures/login-panes). Without an echo, the last 15 lines count, as before."""
    i = prompt_echo(lines, prompt)
    region = lines[i + 1:] if i is not None else [l for l in lines if l.strip()][-15:]
    return next((l.strip() for l in region if any(m in l for m in AUTH_FAILURES)), None)


def watch_start(name, token, prompt):
    """Poll the new pane for START_WAIT seconds; kill the session and fail if
    claude dies or shows a login problem (it stays alive when not logged in).
    A lead that ends its own session within the window has finished, not failed."""
    deadline = time.monotonic() + float(os.environ.get("CAIRN_START_WAIT", START_WAIT))
    while True:
        time.sleep(max(0.0, min(START_POLL, deadline - time.monotonic())))
        r = tmux("display-message", "-p", "-t", f"={name}:", "#{pane_dead}")
        if r.returncode != 0 and session_alive(name) is False:
            # remain-on-exit keeps a crashed pane; a session that is gone was ended by the
            # lead itself (kill-session) because it had nothing more to do.
            return
        alive = r.returncode == 0 and r.stdout.strip() == "0"
        pane = [redact(l, token) for l in pane_lines(name) or []]
        auth = login_failure(pane, prompt)
        lines = [l for l in pane if l.strip()][-15:]
        if not alive or auth:
            tmux("kill-session", "-t", f"={name}")
            if alive:
                raise CairnError(f"claude in {name} has no usable login: {auth}", pane=lines)
            tail = "\n".join(lines).strip() or "(no output)"
            raise CairnError(f"claude exited right after start in {name}:\n{tail}", pane=lines)
        if time.monotonic() >= deadline:
            return


